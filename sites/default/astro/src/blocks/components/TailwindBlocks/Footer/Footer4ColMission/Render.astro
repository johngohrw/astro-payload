---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"footer4ColMission"> = block;

const { logoSrc, logoDarkSrc, logoAlt, missionText, socialLinks, columns, copyrightText } = blockProps;

const remappedProps = {
  logoSrc: getImageUrl(logoSrc),
  logoDarkSrc: getImageUrl(logoDarkSrc),
  logoAlt: logoAlt ?? undefined,
  missionText: missionText ?? undefined,
  socialLinks: socialLinks?.map((s) => ({
    label: s.label ?? "",
    href: s.href ?? "",
    iconSvg: s.iconSvg ?? "",
  })),
  columns: columns?.map((col) => ({
    heading: col.heading ?? "",
    links: col.links?.map((link) => ({
      label: link.label ?? "",
      href: link.href ?? "",
    })) ?? [],
  })),
  copyrightText: copyrightText ?? undefined,
};
---

<Component {...remappedProps} />
