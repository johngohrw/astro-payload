---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"teamLargeImgs"> = block;

const { heading, description, members } = blockProps;

const remappedProps = {
  heading: heading ?? undefined,
  description: description ?? undefined,
  members: members?.map((member) => ({
    name: member.name ?? undefined,
    role: member.role ?? undefined,
    imageSrc: getImageUrl(member.image),
    imageAlt: getImageAlt(member.image),
    socialLinks: member.socialLinks?.map((link) => ({
      label: link.label ?? undefined,
      href: link.href ?? undefined,
      iconSvg: link.iconSvg ?? undefined,
    })),
  })),
};
---

<Component {...remappedProps} />
