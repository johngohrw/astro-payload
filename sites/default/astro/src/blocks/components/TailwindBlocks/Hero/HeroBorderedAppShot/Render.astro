---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"heroBorderedAppShot"> = block;

const { logo, navLinks, login, heading, description, screenshot, primaryCta, secondaryCta } = blockProps;

const remappedProps = {
  logoSrc: getImageUrl(logo),
  logoSrcDark: getImageUrl(logo),
  logoAlt: getImageAlt(logo),
  navLinks: navLinks?.map((link) => ({
    label: link.label ?? undefined,
    href: link.href ?? undefined,
  })),
  loginLabel: login?.label ?? undefined,
  loginHref: login?.href ?? undefined,
  heading: heading ?? undefined,
  description: description ?? undefined,
  screenshotSrc: getImageUrl(screenshot),
  screenshotSrcDark: getImageUrl(screenshot),
  screenshotAlt: getImageAlt(screenshot),
  primaryCta: primaryCta && primaryCta !== null
    ? { label: primaryCta.label ?? undefined, href: primaryCta.href ?? undefined }
    : undefined,
  secondaryCta: secondaryCta && secondaryCta !== null
    ? { label: secondaryCta.label ?? undefined, href: secondaryCta.href ?? undefined }
    : undefined,
};
---

<Component {...remappedProps} />
