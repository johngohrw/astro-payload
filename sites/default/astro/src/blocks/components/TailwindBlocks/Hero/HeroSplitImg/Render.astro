---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt, getImageMeta } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"heroSplitImg"> = block;

const { logo, announcement, heading, description, image, primaryCta, secondaryCta } = blockProps;

const logoUrl = getImageUrl(logo);
const { url: imageUrl, alt: imageAlt } = getImageMeta(image);

const remappedProps = {
  logoSrc: logoUrl,
  logoSrcDark: logoUrl,
  logoAlt: getImageAlt(logo),
  announcementText: announcement?.text ?? undefined,
  announcementHref: announcement?.href ?? undefined,
  heading: heading ?? undefined,
  description: description ?? undefined,
  imageSrc: imageUrl,
  imageAlt: imageAlt,
  primaryCta: primaryCta && primaryCta !== null
    ? { label: primaryCta.label ?? undefined, href: primaryCta.href ?? undefined }
    : undefined,
  secondaryCta: secondaryCta && secondaryCta !== null
    ? { label: secondaryCta.label ?? undefined, href: secondaryCta.href ?? undefined }
    : undefined,
};
---

<Component {...remappedProps} />
