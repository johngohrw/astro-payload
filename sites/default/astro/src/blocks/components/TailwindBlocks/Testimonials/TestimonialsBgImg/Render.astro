---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"testimonialsBgImg"> = block;

const { backgroundImage, backgroundAlt, logo, logoAlt, quote, authorName, authorTitle } = blockProps;

const remappedProps = {
  backgroundSrc: getImageUrl(backgroundImage),
  backgroundAlt: backgroundAlt ?? undefined,
  logoSrc: getImageUrl(logo),
  logoAlt: logoAlt ?? undefined,
  quote: quote ?? undefined,
  authorName: authorName ?? undefined,
  authorTitle: authorTitle ?? undefined,
};
---

<Component {...remappedProps} />
