---
import RenderBlocks from "@astro-default/blocks/RenderBlocks/RenderBlocks.astro";
import TeleplexLayout from "@/layouts/TeleplexLayout.astro";
import { payloadQuery } from "@/utils/payloadQuery";

export async function getStaticPaths() {
  const slugs = [
    "about",
    "career",
    "contact",
    "news-events",
    "products",
    "solutions",
  ];

  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const pageResponse = await payloadQuery.find({
  collection: "pages",
  where: { slug: { equals: slug } },
});
const page = pageResponse.docs[0];
---

{
  !page ? (
    <div>Page with '{slug}' slug not defined in Payload CMS</div>
  ) : (
    <TeleplexLayout title={page.title}>
      <RenderBlocks blocks={page.contentBlocks} />
    </TeleplexLayout>
  )
}

<style></style>
