---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"headerCtrBgImg"> = block;

const { heading, description, backgroundImage } = blockProps;

const remappedProps = {
  heading: heading ?? undefined,
  description: description ?? undefined,
  backgroundImageSrc:
    getImageUrl(backgroundImage),
  backgroundImageAlt:
    getImageAlt(backgroundImage),
};
---

<Component {...remappedProps} />
