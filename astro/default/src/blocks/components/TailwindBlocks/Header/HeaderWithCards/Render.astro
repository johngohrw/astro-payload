---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"headerWithCards"> = block;

const { heading, description, backgroundImage, cards } = blockProps;

const remappedProps = {
  heading: heading ?? undefined,
  description: description ?? undefined,
  backgroundImageSrc:
    getImageUrl(backgroundImage),
  backgroundImageAlt:
    getImageAlt(backgroundImage),
  cards: cards?.map((item) => ({
    iconSvg: item.iconSvg ?? undefined,
    title: item.title ?? "",
    description: item.description ?? "",
  })),
};
---

<Component {...remappedProps} />
