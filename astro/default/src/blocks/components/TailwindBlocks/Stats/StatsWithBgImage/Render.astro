---
import type { BlockTypeOf } from "@/blocks/blockTypes";
import { getImageUrl, getImageAlt } from "@astro-default/utils/media";
import Component from "./Component.astro";

const { block } = Astro.props;

const blockProps: BlockTypeOf<"statsWithBgImage"> = block;

const { lightImage, darkImage, eyebrow, heading, description, stats } = blockProps;

const remappedProps = {
  lightImageSrc: getImageUrl(lightImage),
  darkImageSrc: getImageUrl(darkImage),
  eyebrow: eyebrow ?? undefined,
  heading: heading ?? undefined,
  description: description ?? undefined,
  stats: stats?.map((item) => ({
    label: item.label ?? undefined,
    value: item.value ?? undefined,
  })),
};
---

<Component {...remappedProps} />
