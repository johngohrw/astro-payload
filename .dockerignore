# ── Git ─────────────────────────────────────────────────────
.git
.gitignore

# ── Node & Package Managers ─────────────────────────────────
**/node_modules
.pnpm-store

# ── Build Outputs ───────────────────────────────────────────
**/.next
**/dist
**/out
**/build

# ── Environment Files ───────────────────────────────────────
# Exclude ALL .env files anywhere in the tree
**/.env
**/.env.*
# Keep .env.example as documentation
!.env.example

# ── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Context, Docs & Skills ──────────────────────────────────
.context
.skills
.resources

# ── Logs ────────────────────────────────────────────────────
*.log
.pnpm-debug.log*

# ── Database (never bake local dev DB into image) ───────────
**/data/*.db
**/data/*.db-*

# ── Testing ─────────────────────────────────────────────────
coverage
.nyc_output

# ── IDE ─────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
